definition_text': 'wife', 'tags': []}, {'temp_id': '48779039-abd7-4a67-927e-49a96e93a4ba', 'temp_lexicon_id': (None, 'noun'), 'definition_text': '(obsolete, poetic) woman', 'tags': ['obsolete', 'poetic']}], 'def_sentences': [{'temp_def_id': 'cd1792b2-bdf4-4543-be1a-8cfcd1a29eb9', 'sentence': Quote(text='Они́ жену́ мне хоте́ли взять из орло́вских для того́, что́бы у нас бы́ло обновле́ние родства́.', reference='1887, Николай Лесков [Nikolai Leskov], “Глава третья”, in Грабёж; English translation from Richard Pevear and Larissa Volokhonsky, transl., A Robbery, New York: Alfred A. Knopf, 2013:')}, {'temp_def_id': '48779039-abd7-4a67-927e-49a96e93a4ba', 'sentence': Quote(text='Жёны ра́дости пьют твоё вре́мя, как во́ду,\nА сёстры печа́ли внеза́пны, как дождь;\nЖёнам ра́дости в тя́гость доро́ги свобо́ды,\nА сёстры печа́ли иду́т за тобо́й.\nИду́т за тобо́й, пока́ не умрёшь...', reference='1997, Nautilus Pompilius [Nautilus Pompilius], “Сёстры печали [Sjóstry pečali]”, in Яблокитай:')}], 'pronunciations': [{'temp_lexicon_id': (None, 'noun'), 'text': '[ʐɨˈna]', 'type': 'ipa', 'tags': []}], 'verb_pairs': []}

