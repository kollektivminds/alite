<div class="mw-heading mw-heading4">
<h4 id="Usage_notes">
  Usage notes
 </h4>
<span class="mw-editsection">
<span class="mw-editsection-bracket">
   [
  </span>
<a href="/w/index.php?title=%D0%B1%D0%BE%D0%B3&amp;action=edit&amp;section=37" title="Edit section: Usage notes">
<span>
