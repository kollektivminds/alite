я от свое́й про́поведи.'}, {'temp_def_id': '8eade003-ae6c-4002-8342-e25e7307059e', 'def_example': 'По́сле переустано́вки Windows комп переста́л ви́деть видеока́рту.'}], 'pronunciations': [{'entry_key': UUID('ceb9e2ca-7bcc-5f79-b5c7-b0a9885031e4'), 'pron_text': 'vídetʹ', 'pron_type': 1, 'pron_tags': []}, {'entry_key': UUID('ceb9e2ca-7bcc-5f79-b5c7-b0a9885031e4'), 'pron_text': '[ˈvʲidʲɪtʲ]', 'pron_type': 0, 'pron_tags': None}], 'rel_lems': [{'entry_key': UUID('ceb9e2ca-7bcc-5f79-b5c7-b0a9885031e4'), 'pair_form': 'зави́деть', 'rel_type': 1, 'pair_aspect': 1}, {'entry_key': UUID('ceb9e2ca-7bcc-5f79-b5c7-b0a9885031e4'), 'pair_form': 'зави́деть', 'rel_type': 1, 'pair_aspect': 1}, {'entry_key': UUID('ceb9e2ca-7bcc-5f79-b5c7-b0a9885031e4'), 'pair_form': 'ви́дение', 'rel_type': 3}]}
