': UUID('4e0da558-04b5-5cfc-b553-601c835e1e3c'), 'def_text': 'used to express possession', 'tags': []}, {'temp_def_id': '622ac091-ddf7-4f80-a9c8-4a99b4e9c783', 'entry_key': UUID('4e0da558-04b5-5cfc-b553-601c835e1e3c'), 'def_text': 'am, is, are (used with any person or thing in any number, usually omitted but used for emphasis)', 'tags': []}, {'temp_def_id': 'f7ddaa5e-db36-429a-b593-6da5f5798087', 'entry_key': UUID('8c0df9a3-ad78-5e55-af01-9f4628f53fa9'), 'def_text': 'yes!, hooray!', 'tags': []}, {'temp_def_id': 'd141afd9-4a65-41e8-8892-73caa4a1e20a', 'entry_key': UUID('8c0df9a3-ad78-5e55-af01-9f4628f53fa9'), 'def_text': 'okay, right, roger', 'tags': []}, {'temp_def_id': '20ea9dd7-691c-4ce2-88e4-faa86ca86f28', 'entry_key': UUID('8c0df9a3-ad78-5e55-af01-9f4628f53fa9'), 'def_text': '(military) yessir!', 'tags': []}, {'temp_def_id': 'c91f8cc4-e2e3-4de2-a5aa-f054a021f25e', 'entry_key': UUID('8c0df9a3-ad78-5e55-af01-9f4628f53fa9'), 'def_text': '(nautical) aye-aye!', 'tags': []}], 'def_sentences': [{'temp_def_id': '1d979faf-20b4-4e4c-b41a-f7b3a711f0aa', 'def_sentence': 'Он ел мя́со и сала́т.'}, {'temp_def_id': '1d979faf-20b4-4e4c-b41a-f7b3a711f0aa', 'def_sentence': 'есть поедо́м'}, {'temp_def_id': '1d979faf-20b4-4e4c-b41a-f7b3a711f0aa', 'def_sentence': Quote(text='Как вошёл он в дом Бо́жий при первосвяще́ннике Авиафа́ре и ел хле́бы предложе́ния, кото́рых не должно́ бы́ло есть никому́, кро́ме свяще́нников, и дал и бы́вшим с ним?', reference='1876, Russian Synodal Bible, Mark 2:26:')}, {'temp_def_id': '967a52bc-e029-4a4b-a660-dc1c8907d32c', 'def_sentence': Quote(text='посему́ Сын Челове́ческий есть господи́н и суббо́ты.', reference='1876, Russian Synodal Bible, Mark 2:28:')}, {'temp_def_id': 'c50392c7-c60b-4674-896e-7e4d824ab4eb', 'def_sentence': 'в э́той газе́те есть интере́сная статья́'}, {'temp_def_id': '50ed0044-166c-472d-adbb-10f8dd20e988', 'def_sentence': 'у меня́ есть вопро́с'}, {'temp_def_id': '622ac091-ddf7-4f80-a9c8-4a99b4e9c783', 'def_sentence': 'кто ты есть?'}], 