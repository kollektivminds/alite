9b62-940fa6f8795e'), def_example='Они́ располо́жены так, что все их мо́жно уви́деть.'), DefExamplesRecord(temp_def_id=UUID('95695470-e55f-43ef-9b62-940fa6f8795e'), def_example='Они́ сде́лали так, что́бы всё бы́ло возмо́жно.'), DefExamplesRecord(temp_def_id=UUID('b2bf9a2e-e466-4359-837d-56ea58f487af'), def_example='Она́ звучи́т так (же), как в фи́льмах.'), DefExamplesRecord(temp_def_id=UUID('b2bf9a2e-e466-4359-837d-56ea58f487af'), def_example='Они́ располо́жены так (же), как на схе́ме.'), DefExamplesRecord(temp_def_id=UUID('efd291f2-3bbc-4358-99ff-c0e987e9fb2c'), def_example='Э́то прино́сит по́льзу как молоды́м, так и ста́рым.'), DefExamplesRecord(temp_def_id=UUID('6a86d5b7-b448-4381-9a8a-027cd4cb458d'), def_example='Боле́знь не пройдёт так без лече́ния.'), DefExamplesRecord(temp_def_id=UUID('6a86d5b7-b448-4381-9a8a-027cd4cb458d'), def_example='Э́то тебе́ так не сойдёт с рук.'), DefExamplesRecord(temp_def_id=UUID('311dc243-4e3d-403c-bb01-57afb4257cfb'), def_example='Он вы́глядел та́к себе́, но всё равно́ появи́лся.'), DefExamplesRecord(temp_def_id=UUID('51d4c5a6-18fc-4147-a7d7-6fb68282952c'), def_example='По вку́су она́... Ну так, сре́дненько.'), DefExamplesRecord(temp_def_id=UUID('a1511838-3483-4a0e-a4ee-19abe01acfff'), def_example='Маши́на была́ зелёная. — Так. — И за рулём была́ же́нщина.'), DefExamplesRecord(temp_def_id=UUID('e6c61ea2-ab4f-4690-9b03-d977ae210b39'), def_example='Так, наприме́р...'), DefExamplesRecord(temp_def_id=UUID('e6c61ea2-ab4f-4690-9b03-d977ae210b39'), def_example='Кли́мат там суро́вый, так, моро́зы дохо́дят до 40°.'), DefExamplesRecord(temp_def_id=UUID('5448f4c1-eb79-4801-8584-2d53a3361c47'), def_example='Что с тобо́й? — Так.'), DefExamplesRecord(temp_def_id=UUID('5448f4c1-eb79-4801-8584-2d53a3361c47'), def_example='— О чём ты э́то? — спроси́ла она́ вдруг Ма́рью Дми́триевну. — О чём вздыха́ешь, мать моя́?\n— Так, — промо́лвила та. — Каки́е чуде́сные облака́!\n— Так тебе́ их жа́лко, что́ ли?'), DefExamplesRecord(temp_def_id=UUID('461982de-2cd7-4801-b1f0-82311c4b66cc'), def_example='Де́лать так де́лать.'), DefExamplesRecord(temp_def_id=UUID('461982de-2cd7-4801-b1f0-82311c4b66cc'), def_example='Мне всё равно́: щи так щи, ка́ша так ка́ша.'), DefExamplesRecord(temp_def_id=UUID('42ba1a00-952d-4720-8844-79884f2be96c'), def_example='Так, так(, так), вы - челове́к сло́ва.'), DefExamplesRecord(temp_def_id=UUID('a2f66b81-cae4-4753-9c15-85c0cae5a383'), def_example='Так, так, дава́й не бу́дем выходи́ть из себя́.'), DefExamplesRecord(temp_def_id=UUID('b91dbcdb-3796-4338-b9e1-d0c3bbb6aad0'), def_example='От вокза́ла до до́ма киломе́тра так два.'), DefExamplesRecord(temp_def_id=UUID('b91dbcdb-3796-4338-b9e1-d0c3bbb6aad0'), def_example='Э́то произошло́ лет так де́сять тому́ наза́д.'), DefExamplesRecord(temp_def_id=UUID('c34789e3-abca-4a87-a7e8-4536549f472e'), def_example='Обеща́л, так сде́лай.'), DefExamplesRecord(temp_def_id=UUID('f54680cf-96a9-48f6-b765-034bbdfa8b3e'), def_example='— Здесь оно́ означа́ет «возмуще́ние». – Так э́то не подхо́дит по конте́ксту.'), DefExamplesRecord(temp_def_id=UUID('f54680cf-96a9-48f6-b765-034bbdfa8b3e'), def_example='Пое́хал бы, так де́нег нет.'), DefExamplesRecord(temp_def_id=UUID('ba9c0947-83e4-41e6-bf89-7f2909ec1f9a'), def_example='Что каса́ется криптовалю́т, так у нас о́чень мно́го вариа́нтов.'), DefExamplesRecord(temp_def_id=UUID('ba9c0947-83e4-41e6-bf89-7f2909ec1f9a'), def_example='Всё, что тебе́ ну́жно сейча́с, так э́то запо́мнить все э́ти значе́ния.')] pronunciations=[PronunciationsRecord(entry_key=UUID('a7271a9b-d382-568c-9c7b-fc12383d436b'), text='[tak]', type='ipa', tags=[]), PronunciationsRecord(entry_key=UUID('6a2f4df5-5701-51a7-b122-e498dd5d9ce1'), text='[tak]', type='ipa', tags=[]), PronunciationsRecord(entry_key=UUID('6160dff9-d500-5d10-bca8-542b84f54d2c'), text='[tak]', type='ipa', tags=[]), PronunciationsRecord(entry_key=UUID('8db8f0e3-28d4-5afa-a1ad-1b56f6374bd2'), text='[tak]', type='ipa', tags=[]), PronunciationsRecord(entry_key=UUID('6dd60c16-6313-5590-8bcf-b66b4d5