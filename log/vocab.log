'), 'pron_text': 'člen', 'pron_type': 1, 'pron_tags': ''}, {'entry_key': UUID('7799beaf-727c-5e21-a52e-602217b24e6d'), 'pron_text': '[t͡ɕlʲen]', 'pron_type': 0, 'pron_tags': None}], 'verb_pairs': []}
