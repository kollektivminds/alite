ого отделения мятежных горных районов от молодой республики'), DefExamplesRecord(temp_def_id=UUID('317aeada-3c6b-4a3a-9ba5-1cc312883d9d'), def_example='Умерший, палый лист лежал рядом с головою Вощева, его принес ветер с дальнего дерева, и теперь этому листу предстояло смирение в земле. Вощев подобрал отсохший лист и спрятал его в тайное отделение мешка, где он сберегал всякие предметы несчастья и безвестности.')] pronunciations=[PronunciationsRecord(entry_key=UUID('643a7974-a472-54d5-8cc9-71d41528a36d'), pron_text='otdelénije', pron_type=1, pron_tags=''), PronunciationsRecord(entry_key=UUID('643a7974-a472-54d5-8cc9-71d41528a36d'), pron_text='[ɐdʲːɪˈlʲenʲɪje]', pron_type=0, pron_tags=None)] verb_pairs=[]

