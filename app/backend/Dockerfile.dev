# app/backend/Dockerfile.dev

# --- Base Image ---
FROM python:3.13-slim

# Prevent bytecode generation (.pyc) and enforce unbuffered standard I/O streams
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_VERSION=1.8.5 \
    POETRY_VIRTUALENVS_CREATE=false \
    PYTHONPATH=/app/src \
    PATH="/root/.local/bin:$PATH"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    && curl -sSL https://install.python-poetry.org | python3 - --version ${POETRY_VERSION} \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

# copy dependency manifests first to utilize Docker layer caching
COPY pyproject.toml poetry.lock* ./

# install dependencies into global system Python inside the container
RUN poetry install --no-interaction --no-ansi --no-root

COPY . ./

EXPOSE 8000 5678

# execute Uvicorn with auto-reload enabled for live development
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]